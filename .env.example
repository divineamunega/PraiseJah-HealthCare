# --- DATABASE CONFIGURATION ---
# Use the service name 'database' defined in docker-compose.yml
POSTGRES_USER=praisejah_admin
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=praisejah_healthcare
DATABASE_URL="postgresql://praisejah_admin:secure_password_here@database:5432/praisejah_healthcare?schema=public"

# --- REDIS CONFIGURATION ---
# Use the service name 'redis' defined in docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- BACKEND SERVER CONFIGURATION ---
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# --- SECURITY (JWT) ---
# Generate strong secrets for production!
JWT_ACCESS_SECRET=your_jwt_access_secret_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- THIRD-PARTY SERVICES ---
# Resend API Key for emails
RESEND_API_KEY=re_123456789

# Sentry DSN
SENTRY_DSN=your_sentry_dsn

# --- FRONTEND CONFIGURATION ---
# Leave blank to use relative paths (recommended for Nginx proxy)
VITE_API_URL=
VITE_WS_URL=
